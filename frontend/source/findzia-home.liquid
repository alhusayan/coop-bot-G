    it:['Dettagli e consigli','Punti di forza','Da considerare','Ideale per','Verifica in negozio','Caratteristiche','Vedi prodotto','Analisi IA della scheda','Preparazione dei consigli…','Riprova','Chiudi','Fonte','Offerte comparabili','Altri dettagli','Analisi IA temporaneamente non disponibile.'],
    pt:['Detalhes e análise','Destaques','A considerar','Indicado para','Confirme na loja','Especificações','Ver produto','Análise IA do anúncio','Preparando dicas…','Tentar novamente','Fechar','Fonte','Ofertas comparáveis','Mais detalhes','Análise IA temporariamente indisponível.'],
    tr:['Ürün detayları ve analiz','Öne çıkanlar','Dikkat edilmesi gerekenler','Kimler için','Mağazadan doğrulayın','Özellikler','Ürünü görüntüle','İlan bilgilerinin yapay zekâ yorumu','Öneriler hazırlanıyor…','Tekrar dene','Kapat','Kaynak','Karşılaştırılabilir teklifler','Diğer detaylar','Yapay zekâ analizi geçici olarak kullanılamıyor.'],
    ru:['Детали и анализ','Преимущества','Что учесть','Кому подойдёт','Уточните в магазине','Характеристики','Посмотреть товар','Анализ описания с ИИ','Готовим краткий обзор…','Повторить','Закрыть','Источник','Сопоставимые предложения','Подробнее','Анализ ИИ временно недоступен.'],
    ja:['商品詳細と分析','主な特徴','購入前の注意','おすすめの用途','店舗に確認','商品仕様','商品を見る','掲載情報のAI分析','購入ガイドを準備中…','再試行','閉じる','情報源','同等商品の比較','詳細を見る','AI分析は現在利用できません。'],
    ko:['상품 정보 및 분석','주요 장점','구매 전 고려 사항','추천 대상','판매처에 확인','상품 사양','상품 보기','상품 정보의 AI 해석','구매 안내 준비 중…','다시 시도','닫기','출처','동일 상품 비교','자세히 보기','AI 분석을 일시적으로 이용할 수 없습니다.'],
    hi:['उत्पाद विवरण और जानकारी','खास बातें','खरीदने से पहले','किसके लिए','दुकान से पुष्टि करें','विशेषताएँ','उत्पाद देखें','विवरण का AI विश्लेषण','संक्षिप्त सुझाव तैयार हो रहे हैं…','फिर कोशिश करें','बंद करें','स्रोत','समान ऑफ़र','और विवरण','AI विश्लेषण अभी उपलब्ध नहीं है।'],
    ur:['مصنوعات کی تفصیل اور جائزہ','نمایاں خوبیاں','خریدنے سے پہلے','کس کے لیے','دکان سے تصدیق کریں','خصوصیات','مصنوعات دیکھیں','تفصیلات کا AI جائزہ','مختصر مشورہ تیار ہو رہا ہے…','دوبارہ کوشش','بند کریں','ماخذ','مماثل پیشکشیں','مزید تفصیلات','AI جائزہ عارضی طور پر دستیاب نہیں۔'],
    id:['Detail dan wawasan produk','Keunggulan','Sebelum membeli','Cocok untuk','Periksa di toko','Spesifikasi','Lihat produk','Interpretasi AI dari detail produk','Menyiapkan panduan singkat…','Coba lagi','Tutup','Sumber','Penawaran sebanding','Detail lainnya','Wawasan AI sementara tidak tersedia.'],
    ms:['Butiran dan panduan produk','Kelebihan','Sebelum membeli','Sesuai untuk','Semak dengan kedai','Spesifikasi','Lihat produk','Tafsiran AI tentang produk','Menyediakan panduan ringkas…','Cuba lagi','Tutup','Sumber','Tawaran setanding','Butiran lanjut','Panduan AI tidak tersedia buat sementara.']
  };
  let dialog,body,button,controller,sequence=0,previousOverflow=null,current={};
  const cache=new Map();
  const lang=()=>root.dataset.lang||'en';
  const t=n=>(labels[lang()]||labels.en)[n];
  function node(tag,cls,text){const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=String(text);return n;}
  function url(v){try{const u=new URL(v);return /^https?:$/.test(u.protocol)&&!u.username&&!u.password?u.href:'';}catch{return '';}}
  function close(){sequence++;controller?.abort();dialog?.close();if(previousOverflow!==null){document.body.style.overflow=previousOverflow;previousOverflow=null;}if(button?.isConnected)button.focus({preventScroll:true});}
  function link(href,text){const a=node('a','',text);a.href=url(href);a.target='_blank';a.rel='noopener noreferrer';return a;}
  function ensure(){if(dialog)return;dialog=node('dialog','fz-insights');dialog.setAttribute('aria-labelledby',root.id+'-insight-title');
    const head=node('header','fz-insights-head'),title=node('h2');title.id=root.id+'-insight-title';
    const exit=node('button','fz-insights-close','×');exit.type='button';exit.onclick=close;head.append(title,exit);
    body=node('div','fz-insights-body');dialog.append(head,body);root.append(dialog);
    dialog.addEventListener('cancel',e=>{e.preventDefault();close();});
    dialog.addEventListener('click',e=>{if(e.target!==dialog)return;const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)close();});
  }
  function render(h,loading=false){
    body.replaceChildren();const p=h?.product||{},row=current,hero=node('div','fz-insights-hero');
    const src=url(row.image||row.thumbnail);if(src){const img=node('img');img.src=src;img.alt='';img.referrerPolicy='no-referrer';img.onerror=()=>img.remove();hero.append(img);}
    const copy=node('div');copy.append(node('span','fz-insights-store',p.store||row.store||''),node('h3','',p.title||row.raw_title||row.title||''));
    if(p.display_price||row.price)copy.append(node('strong','fz-insights-price',p.display_price||row.price));hero.append(copy);body.append(hero);
    const facts=p.facts||row.key_specs||[];if(facts.length){const list=node('dl','fz-insights-specs');for(const fact of facts.slice(0,6)){if(!fact?.value)continue;const cell=node('div');cell.append(node('dd','',fact.value));list.append(cell);}if(list.children.length)body.append(list);}
    if(loading){const status=node('p','fz-insights-loading',t(8));status.setAttribute('role','status');body.append(status);}
    if(h?.ai_status==='ready'){
      body.append(node('p','fz-insights-method',t(7)));
      if(h.summary?.text)body.append(node('p','fz-insights-summary',h.summary.text));
      const grid=node('div','fz-insights-grid');
      function section(label,points,kind){points=(points||[]).filter(p=>p?.text);if(!points.length)return;const s=node('section','fz-insights-section '+kind);s.append(node('h4','',label));const ul=node('ul');for(const point of points.slice(0,2)){const li=node('li','',point.text);li.dataset.inference=String(!!point.inference);ul.append(li);}s.append(ul);grid.append(s);}
      section(t(1),h.strengths,'advantages');section(t(2),h.cautions,'considerations');body.append(grid);
      section(t(3),h.best_for?[h.best_for]:[],'suitable');section(t(4),h.checks,'checks');
    }
    if(h?.market?.status==='sample_compared'){
      const section=node('section','fz-insights-comparison');section.append(node('h4','',t(12)));
      for(const offer of h.market.offers||[]){const source=h.sources?.find(s=>s.id===offer.id);if(!url(source?.url))continue;const a=link(source.url,source.store||source.title);a.append(node('b','',new Intl.NumberFormat(lang(),{style:'currency',currency:offer.currency}).format(offer.amount)));section.append(a);}body.append(section);
    }
    const description=String(row.card_description||row.description||row.snippet||'').trim();
    if(description&&description!==String(p.title||row.title||'')){const details=node('details','fz-insights-details');details.append(node('summary','',t(13)),node('p','',description.slice(0,500)));body.append(details);}
    const sourceUrl=url(p.url||row.url);if(sourceUrl){const footer=node('footer','fz-insights-footer');const cta=link(sourceUrl,t(6)+' ↗');cta.className='fz-insights-cta';footer.append(cta);body.append(footer);}
    if(h&&h.ai_status!=='ready'){const status=node('p','fz-insights-muted',t(14));body.append(status);}
    if(h?.sources?.length){const details=node('details','fz-insights-details');details.append(node('summary','',t(11)));for(const source of h.sources.slice(0,5)){if(!url(source.url))continue;details.append(link(source.url,source.store||source.title));}body.append(details);}
  }
  async function open(trigger){
    ensure();button=trigger;const bridge=root.fzRefineBridge,rows=bridge?.snapshot()?.view?.items||[],token=trigger.dataset.evaluate;
    current=rows.find(r=>token&&r.evaluation_token===token)||rows.find(r=>r.url===trigger.dataset.offerKey)||{};
    dialog.dir=['ar','ur','fa','he'].includes(lang())?'rtl':'ltr';dialog.querySelector('h2').textContent=t(0);dialog.querySelector('button').setAttribute('aria-label',t(10));
    controller?.abort();const id=++sequence;controller=new AbortController();const signal=controller.signal;
    if(!dialog.open){dialog.showModal();previousOverflow=document.body.style.overflow;document.body.style.overflow='hidden';}
    dialog.querySelector('button').focus({preventScroll:true});render(null,!!token);body.scrollTop=0;
    if(!token||!bridge?.api)return;
    const peers=rows.filter(r=>r.evaluation_token&&r.evaluation_token!==token).slice(0,12).map(r=>r.evaluation_token);
    const key=JSON.stringify([token,peers,lang()]),hit=cache.get(key);
    if(hit&&Date.now()-hit.time<600000){render(hit.data);return;}
    const timer=setTimeout(()=>controller?.signal===signal&&controller.abort(),12000);
    try{const response=await window.FindziaBillingFetch(root,bridge.api+'/api/evaluate',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({token,peer_tokens:peers,lang:lang()}),signal});
      const data=await response.json();if(id!==sequence||!dialog.open)return;if(!response.ok||!data.ok)throw Error(data.error||'unavailable');
      if(data.ai_status==='ready'){cache.set(key,{time:Date.now(),data});if(cache.size>30)cache.delete(cache.keys().next().value);}render(data);
    }catch(error){if(id!==sequence||!dialog.open)return;render({ai_status:'unavailable'});const retry=node('button','fz-insights-retry',t(9));retry.type='button';retry.onclick=()=>open(trigger);body.append(retry);
    }finally{clearTimeout(timer);}
  }
  function click(e){const trigger=e.target.closest('[data-evaluate]');if(!trigger||!root.contains(trigger))return;e.preventDefault();e.stopPropagation();open(trigger);}
  root.addEventListener('click',click,true);root.addEventListener('fz:search-reset',close);
  document.addEventListener('shopify:section:unload',function unload(e){if(!e.target?.contains(root))return;close();root.removeEventListener('click',click,true);root.removeEventListener('fz:search-reset',close);document.removeEventListener('shopify:section:unload',unload);dialog?.remove();});
})();
</script>


